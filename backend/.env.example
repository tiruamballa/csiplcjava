# --- Backend configuration (never commit this file) ---
# Generate a new secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite for development. For PostgreSQL later:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/java_for_dsa
DATABASE_URL=sqlite:///./java_for_dsa.db

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used to decide what "today" means for the public site
TIMEZONE=Asia/Kolkata
